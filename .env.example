# 로컬에서 복사 후 설정. 실제 값은 Git에 추가하지 않는다.
AI_SERVICE_TOKEN=
AI_OPENAI_API_KEY=
# Structured Outputs를 지원하는 사용 가능한 모델 ID를 명시한다.
AI_OPENAI_MODEL=
# 운영 정책과 모임 vector(1536)에 사용하는 고정 임베딩 모델 ID.
AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 정책 후보는 이 하이브리드 점수 이상만 사용하며, 상위 결과만 LLM에 전달한다.
AI_MODERATION_POLICY_MIN_HYBRID_SCORE=0.30
AI_MODERATION_POLICY_RESULT_LIMIT=5
AI_BACKEND_URL=http://127.0.0.1:8080
AI_MCP_URL=http://127.0.0.1:8001/mcp/
# 기본값은 비활성화다. Spring/Kafka와 함께 실행할 때만 true로 설정한다.
AI_KAFKA_CONSUMER_ENABLED=false
AI_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
AI_KAFKA_CONSUMER_GROUP=meetple-ai-report-analysis-v1
AI_KAFKA_TOPIC=meetple.moderation.report-analysis.v1
AI_KAFKA_RETRY_DELAYS_SECONDS=[5,30,120,600]
AI_KAFKA_MAX_POLL_INTERVAL_MS=900000
